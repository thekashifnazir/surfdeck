{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "surfdeck",
  "compatibility_date": "2025-04-01",
  "main": "./src/worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ouroboros"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surfdeck-db",
      "database_id": "ae532fb8-3cac-4a58-b46f-4d5076ab8e2e"
    }
  ]
}
