@@ -0,0 +1,709 @@
+/* ============================================================
+   Surfdeck — Remote + Card Printer
+   A TV remote for the hand-made web.
+   ============================================================ */
+
+/* 1. @font-face declarations
+   ------------------------------------------------------------ */
+@font-face {
+  font-family: 'Familjen Grotesk';
+  font-style: normal;
+  font-weight: 400 700;
+  font-display: swap;
+  src: url('/fonts/familjen-grotesk-latin.woff2') format('woff2');
+}
+
+@font-face {
+  font-family: 'Doto';
+  font-style: normal;
+  font-weight: 900;
+  font-display: swap;
+  src: url('/fonts/doto-900.woff') format('woff');
+}
+
+@font-face {
+  font-family: 'Special Elite';
+  font-style: normal;
+  font-weight: 400;
+  font-display: swap;
+  src: url('/fonts/special-elite-400.woff2') format('woff2');
+}
+
+/* 2. CSS Custom Properties
+   ------------------------------------------------------------ */
+:root {
+  /* Palette */
+  --bg: #F2F0E9;
+  --card-white: #FFFFFF;
+  --ink: #26262A;
+  --body-grey: #6E6A5E;
+  --caption-grey: #8A867A;
+  --key-shadow: #B8B4A8;
+  --device-charcoal: #2B2B2E;
+  --screen: #191916;
+  --lcd-bg: #1A241A;
+  --deep-shadow-1: #141416;
+  --deep-shadow-2: #17171A;
+  --coral: #E8542F;
+  --coral-pressed: #A33417;
+  --lcd-green: #9FE870;
+
+  /* Typography */
+  --font-body: 'Familjen Grotesk', 'Arial', 'Helvetica Neue', sans-serif;
+  --font-lcd: 'Doto', 'Courier New', 'Lucida Console', monospace;
+  --font-card: 'Special Elite', 'Courier New', 'Lucida Console', monospace;
+
+  /* Timing */
+  --zap-full: 2000ms;
+  --zap-compressed: 1000ms;
+  --static-full: 800ms;
+  --static-compressed: 400ms;
+  --card-delay-full: 1000ms;
+  --card-delay-compressed: 500ms;
+  --card-slide: 300ms;
+}
+
+/* 3. Reset / Base
+   ------------------------------------------------------------ */
+*, *::before, *::after {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  padding: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-body);
+  font-weight: 400;
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+/* 4. Layout — Scene
+   ------------------------------------------------------------ */
+.page {
+  max-width: 960px;
+  margin: 0 auto;
+  padding: 2rem 1.5rem;
+}
+
+.hero {
+  text-align: center;
+  margin-bottom: 2rem;
+}
+
+.hero__wordmark {
+  font-family: var(--font-body);
+  font-weight: 700;
+  font-size: 1.5rem;
+  color: var(--ink);
+  margin: 0 0 0.25rem;
+  letter-spacing: -0.01em;
+}
+
+.hero__headline {
+  font-size: 1rem;
+  color: var(--body-grey);
+  margin: 0;
+  font-weight: 400;
+}
+
+.scene {
+  display: flex;
+  flex-direction: row;
+  align-items: flex-start;
+  gap: 2rem;
+  margin-bottom: 2rem;
+}
+
+/* 5. Remote
+   ------------------------------------------------------------ */
+.remote {
+  width: 240px;
+  min-width: 240px;
+  background: var(--device-charcoal);
+  border-radius: 24px 24px 32px 32px;
+  padding: 1.5rem 1.25rem 2rem;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 1rem;
+  box-shadow:
+    0 8px 24px rgba(0, 0, 0, 0.3),
+    inset 0 1px 0 rgba(255, 255, 255, 0.05);
+  position: relative;
+}
+
+/* IR LED */
+.ir-led {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--deep-shadow-1);
+  position: absolute;
+  top: 12px;
+  left: 50%;
+  transform: translateX(-50%);
+  transition: background 0.1s;
+}
+
+.ir-led--blip {
+  animation: led-blip-3 0.9s ease-out;
+}
+
+.ir-led--blip-fast {
+  animation: led-blip-2 0.6s ease-out;
+}
+
+/* LCD Readout */
+.lcd {
+  width: 100%;
+  background: var(--lcd-bg);
+  border-radius: 4px;
+  padding: 0.5rem 0.75rem;
+  min-height: 2.5rem;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  border: 1px solid rgba(159, 232, 112, 0.1);
+}
+
+.lcd__text {
+  font-family: var(--font-lcd);
+  font-weight: 900;
+  font-size: 0.7rem;
+  color: var(--lcd-green);
+  line-height: 1.3;
+  text-transform: uppercase;
+  letter-spacing: 0.03em;
+}
+
+.lcd--flicker {
+  animation: lcd-flicker 0.3s steps(3);
+}
+
+/* SURF Key */
+.surf-key {
+  width: 100%;
+  padding: 1rem;
+  font-family: var(--font-body);
+  font-weight: 700;
+  font-size: 1.1rem;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+  color: #fff;
+  background: var(--coral);
+  border: none;
+  border-radius: 12px;
+  cursor: pointer;
+  position: relative;
+  transform: translateY(0);
+  box-shadow:
+    0 4px 0 var(--coral-pressed),
+    0 6px 12px rgba(0, 0, 0, 0.3);
+  transition: transform 0.08s ease, box-shadow 0.08s ease;
+  min-height: 52px;
+}
+
+.surf-key:hover {
+  background: #d94a28;
+}
+
+.surf-key:active,
+.surf-key--pressed {
+  transform: translateY(3px);
+  box-shadow:
+    0 1px 0 var(--coral-pressed),
+    0 2px 4px rgba(0, 0, 0, 0.2);
+}
+
+.surf-key:disabled {
+  opacity: 0.7;
+  cursor: not-allowed;
+}
+
+/* Mood Keys */
+.mood-keys {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0.4rem;
+  width: 100%;
+}
+
+.mood-key {
+  padding: 0.5rem 0.25rem;
+  font-family: var(--font-body);
+  font-weight: 600;
+  font-size: 0.65rem;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: #ccc;
+  background: var(--deep-shadow-1);
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  min-height: 44px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: 0 2px 0 var(--deep-shadow-2);
+  transition: background 0.1s, color 0.1s, box-shadow 0.1s;
+}
+
+.mood-key:hover {
+  background: #222225;
+  color: #fff;
+}
+
+.mood-key--active {
+  background: var(--coral);
+  color: #fff;
+  box-shadow: 0 2px 0 var(--coral-pressed);
+}
+
+/* INPUT Key */
+.input-key {
+  width: 100%;
+  padding: 0.5rem;
+  font-family: var(--font-body);
+  font-weight: 600;
+  font-size: 0.6rem;
+  letter-spacing: 0.03em;
+  text-transform: uppercase;
+  color: #999;
+  background: var(--deep-shadow-2);
+  border: 1px solid #333;
+  border-radius: 6px;
+  cursor: pointer;
+  min-height: 44px;
+  transition: color 0.15s, border-color 0.15s;
+}
+
+.input-key:hover {
+  color: #fff;
+  border-color: #555;
+}
+
+.input-key--active {
+  color: var(--lcd-green);
+  border-color: rgba(159, 232, 112, 0.3);
+}
+
+/* 6. Telly
+   ------------------------------------------------------------ */
+.telly-container {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.telly {
+  background: #222;
+  border-radius: 12px;
+  padding: 12px;
+  box-shadow:
+    0 8px 24px rgba(0, 0, 0, 0.2),
+    inset 0 0 0 2px #333;
+}
+
+.telly__screen {
+  width: 100%;
+  aspect-ratio: 16 / 10;
+  background: var(--screen);
+  border-radius: 4px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  position: relative;
+  overflow: hidden;
+}
+
+/* Telly states */
+.telly__screen--idle {
+  /* Dark, off — faint scanline hint */
+}
+
+.telly__screen--idle::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: repeating-linear-gradient(
+    transparent,
+    transparent 2px,
+    rgba(0, 0, 0, 0.03) 2px,
+    rgba(0, 0, 0, 0.03) 4px
+  );
+  pointer-events: none;
+}
+
+.telly__screen--static {
+  animation: static-noise var(--static-full) steps(8) forwards;
+}
+
+.telly__screen--static-fast {
+  animation: static-noise var(--static-compressed) steps(6) forwards;
+}
+
+.telly__screen--tuned {
+  /* Channel is displayed — no static */
+}
+
+.telly__screen--exhausted {
+  animation: static-noise 2s steps(8) infinite;
+}
+
+/* Channel display */
+.telly__channel {
+  font-family: var(--font-lcd);
+  font-weight: 900;
+  font-size: clamp(2rem, 5vw, 3.5rem);
+  color: #fff;
+  text-align: center;
+  line-height: 1.1;
+}
+
+.telly__subtitle {
+  font-family: var(--font-body);
+  font-size: 0.8rem;
+  color: var(--caption-grey);
+  margin-top: 0.5rem;
+  text-align: center;
+}
+
+.telly__no-signal {
+  font-family: var(--font-lcd);
+  font-weight: 900;
+  font-size: 1.5rem;
+  color: #fff;
+  text-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
+}
+
+/* 7. Card Slot
+   ------------------------------------------------------------ */
+.card-slot {
+  margin-top: 0.75rem;
+  overflow: hidden;
+  position: relative;
+}
+
+.card-slot__inner {
+  transform: translateY(110%);
+  transition: transform var(--card-slide) ease-out;
+}
+
+.card-slot--visible .card-slot__inner {
+  transform: translateY(0);
+}
+
+.card-slot--ducking .card-slot__inner {
+  transform: translateY(110%);
+  transition: transform 0.15s ease-in;
+}
+
+/* 8. Provenance Card
+   ------------------------------------------------------------ */
+.prov-card {
+  background: var(--card-white);
+  border: 1px solid #e0ddd5;
+  border-radius: 8px;
+  padding: 1.25rem 1.5rem;
+  font-family: var(--font-card);
+  position: relative;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
+}
+
+.prov-card__heading {
+  font-family: var(--font-body);
+  font-size: 0.65rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--caption-grey);
+  margin: 0 0 0.75rem;
+}
+
+.prov-card__body {
+  font-size: 1rem;
+  color: var(--ink);
+  margin: 0 0 0.75rem;
+  line-height: 1.5;
+}
+
+.prov-card__body--fallback {
+  font-style: italic;
+  color: var(--body-grey);
+}
+
+.prov-card__footer {
+  font-family: var(--font-body);
+  font-size: 0.75rem;
+  color: var(--caption-grey);
+  margin: 0;
+  font-style: italic;
+}
+
+.prov-card__stamp {
+  position: absolute;
+  top: 1rem;
+  right: 1rem;
+  font-family: var(--font-body);
+  font-size: 0.55rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--coral);
+  border: 1.5px solid var(--coral);
+  padding: 0.2rem 0.4rem;
+  border-radius: 3px;
+  transform: rotate(3deg);
+  opacity: 0.8;
+}
+
+/* 9. Filters (chip rows below scene)
+   ------------------------------------------------------------ */
+.filters {
+  margin-bottom: 1.5rem;
+}
+
+.filters__group {
+  margin-bottom: 0.75rem;
+}
+
+.filters__label {
+  font-size: 0.7rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--caption-grey);
+  margin-bottom: 0.4rem;
+}
+
+.chip-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+}
+
+.chip {
+  padding: 0.4rem 0.75rem;
+  font-family: var(--font-body);
+  font-size: 0.75rem;
+  font-weight: 400;
+  color: var(--body-grey);
+  background: var(--card-white);
+  border: 1px solid var(--key-shadow);
+  border-radius: 100px;
+  cursor: pointer;
+  transition: background 0.12s, color 0.12s, border-color 0.12s;
+  min-height: 36px;
+  display: flex;
+  align-items: center;
+}
+
+.chip:hover {
+  border-color: var(--body-grey);
+  color: var(--ink);
+}
+
+.chip--active {
+  background: var(--coral);
+  color: #fff;
+  border-color: var(--coral);
+  font-weight: 600;
+}
+
+.chip--active:hover {
+  background: #d94a28;
+  border-color: #d94a28;
+  color: #fff;
+}
+
+/* 10. Status line
+   ------------------------------------------------------------ */
+.status-line {
+  text-align: center;
+  padding: 1rem 0;
+}
+
+.status-line__text {
+  font-size: 0.9rem;
+  color: var(--body-grey);
+  margin: 0 0 0.5rem;
+}
+
+.status-line__sub {
+  font-size: 0.8rem;
+  color: var(--caption-grey);
+  margin: 0;
+}
+
+.status-line__link {
+  color: var(--coral);
+  text-decoration: underline;
+  cursor: pointer;
+}
+
+.status-line__link:hover {
+  color: var(--coral-pressed);
+}
+
+.reset-btn {
+  margin-top: 0.75rem;
+  padding: 0.5rem 1.25rem;
+  font-family: var(--font-body);
+  font-size: 0.8rem;
+  font-weight: 600;
+  color: #fff;
+  background: var(--coral);
+  border: none;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background 0.12s;
+}
+
+.reset-btn:hover {
+  background: var(--coral-pressed);
+}
+
+/* 11. Keyframe Animations
+   ------------------------------------------------------------ */
+
+/* Static noise effect */
+@keyframes static-noise {
+  0% { background-position: 0 0; }
+  100% { background-position: -200px -200px; }
+}
+
+.telly__screen--static,
+.telly__screen--static-fast,
+.telly__screen--exhausted {
+  background-image:
+    repeating-linear-gradient(
+      0deg,
+      transparent,
+      transparent 1px,
+      rgba(255, 255, 255, 0.02) 1px,
+      rgba(255, 255, 255, 0.02) 2px
+    ),
+    repeating-linear-gradient(
+      90deg,
+      transparent,
+      transparent 2px,
+      rgba(255, 255, 255, 0.015) 2px,
+      rgba(255, 255, 255, 0.015) 4px
+    ),
+    url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.15'/%3E%3C/svg%3E");
+  background-color: var(--screen);
+  background-size: 200px 200px;
+}
+
+/* LED blip — 3 pulses (full ceremony) */
+@keyframes led-blip-3 {
+  0%, 100% { background: var(--deep-shadow-1); }
+  10%, 20% { background: var(--coral); box-shadow: 0 0 6px var(--coral); }
+  30%, 40% { background: var(--deep-shadow-1); }
+  43%, 53% { background: var(--coral); box-shadow: 0 0 6px var(--coral); }
+  63%, 73% { background: var(--deep-shadow-1); }
+  76%, 86% { background: var(--coral); box-shadow: 0 0 6px var(--coral); }
+}
+
+/* LED blip — 2 pulses (compressed) */
+@keyframes led-blip-2 {
+  0%, 100% { background: var(--deep-shadow-1); }
+  15%, 30% { background: var(--coral); box-shadow: 0 0 6px var(--coral); }
+  45%, 60% { background: var(--deep-shadow-1); }
+  65%, 80% { background: var(--coral); box-shadow: 0 0 6px var(--coral); }
+}
+
+/* LCD flicker */
+@keyframes lcd-flicker {
+  0% { opacity: 1; }
+  33% { opacity: 0.3; }
+  66% { opacity: 0.8; }
+  100% { opacity: 1; }
+}
+
+/* 12. @media (prefers-reduced-motion: reduce)
+   ------------------------------------------------------------ */
+@media (prefers-reduced-motion: reduce) {
+  .ir-led--blip,
+  .ir-led--blip-fast {
+    animation: none;
+  }
+
+  .lcd--flicker {
+    animation: none;
+  }
+
+  .telly__screen--static,
+  .telly__screen--static-fast {
+    animation: none;
+    background-image: none;
+  }
+
+  .telly__screen--exhausted {
+    animation: none;
+  }
+
+  .card-slot__inner {
+    transition: none;
+  }
+
+  .card-slot--visible .card-slot__inner {
+    transform: translateY(0);
+  }
+
