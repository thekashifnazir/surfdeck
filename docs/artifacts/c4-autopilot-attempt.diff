diff --git a/src/client/components/CardSlot.tsx b/src/client/components/CardSlot.tsx
new file mode 100644
index 0000000..b2a31c9
--- /dev/null
+++ b/src/client/components/CardSlot.tsx
@@ -0,0 +1,31 @@
+import type { ReactNode } from "react";
+
+export interface CardSlotProps {
+  /** Whether the card should be visible (slid out) */
+  visible: boolean;
+  /** Whether the card is currently ducking back in before reprint */
+  ducking: boolean;
+  children: ReactNode;
+}
+
+/**
+ * CardSlot — the physical slot under the Telly from which
+ * the provenance card slides out. Manages the print/duck animation
+ * via CSS classes.
+ */
+export default function CardSlot({ visible, ducking, children }: CardSlotProps) {
+  let slotClass = "card-slot";
+  if (ducking) {
+    slotClass += " card-slot--ducking";
+  } else if (visible) {
+    slotClass += " card-slot--visible";
+  }
+
+  return (
+    <div className={slotClass} aria-label="Provenance card slot">
+      <div className="card-slot__inner">
+        {children}
+      </div>
+    </div>
+  );
+}
